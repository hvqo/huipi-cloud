{
  "name": "huipi-teacher-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:demo": "playwright test -c playwright.demo.config.ts",
    "api:generate": "openapi-typescript .cache/openapi.json -o src/api/generated.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "element-plus": "^2.14.7",
    "lucide-vue-next": "^1.0.0",
    "oidc-client-ts": "^3.5.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}

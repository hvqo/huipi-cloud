# Public SPA configuration only. Never place API keys or client secrets in VITE_*.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile
# Provider-specific audience, or standards-based resource indicator; configure with your IdP.
VITE_OIDC_AUDIENCE=
VITE_OIDC_RESOURCE=
# Local development proxy; production uses same-origin /api via reverse proxy.
WORKBENCH_API_TARGET=http://127.0.0.1:8000

  "critical_false_credit_tags": [
    "false_credit_guard",
    "keyword_only",
    "missing_steps",
    "prompt_content_confusion",
    "prompt_copy",
    "stem_as_answer",
    "unbalanced_equation",
    "overcredit_trap"
  ]

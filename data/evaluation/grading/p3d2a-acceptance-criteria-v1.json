    "abstention_probe_expected_abstain": "5/5"
  },
  "score_quality_gates": {
    "candidate_total_score_mae_maximum_points": "0.75",
    "candidate_criterion_score_mae_maximum_points": "0.50",
    "candidate_total_exact_match_minimum": "80%",
    "candidate_criterion_exact_match_minimum": "80%",
    "zero_reference_positive_total_score_allowed": "0/9",
    "critical_zero_reference_criterion_false_credit_allowed": "0"
  },
  "human_semantic_gate": {
    "required_before_any_production_integration": "all positive-scored model criteria and all overestimate-risk cases reviewed by a qualified human",
    "required_quote_support_status": "reviewed_and_supported",
    "current_status": "unreviewed",
    "synthetic_label_provenance_is_not_teacher_double_scoring": true
  },
  "decision_rule": "All engineering and score gates must pass, and human semantic review must be complete, before considering a later production-integration proposal. Passing synthetic gates alone is never production-grading authorization.",
  "high_risk_zero_score_case_ids": [
    "v3-decimal-strict",
    "v3-chem-unbalanced",
    "v3-bio-keyword-copy",

{
  "criteria_version": "1.0",
  "experiment": "P3-D2A grading quality v3 holdout",
  "dataset_version": "3.0",
  "locked_before_model_requests": true,
  "request_policy": {
    "provider": "DeepSeek OpenAI-compatible",
    "model": "deepseek-flash",
    "thinking": "disabled",
    "requests_per_case": 1,
    "retries": 0,
    "max_output_tokens": 4096,
    "timeout_seconds": 120,
    "max_estimated_cost_usd": "0.50",
    "uncertain_case_policy": "send one abstention probe; exclude it from score metrics"

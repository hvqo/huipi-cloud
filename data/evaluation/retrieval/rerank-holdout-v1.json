  "documents": [
    {
      "id": "osmosis",
      "assignment": "A",
      "title": "渗透作用",
      "text": "# 渗透作用\n\n渗透作用是水分子通过半透膜由水势较高一侧向水势较低一侧净移动，溶质不一定能穿膜。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "enzyme",
      "assignment": "A",
      "title": "酶的专一性",
      "text": "# 酶的专一性\n\n酶是生物催化剂，通常对特定底物具有专一性。高温可破坏其空间结构使之失活，适当低温主要降低反应速率。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "meiosis",
      "assignment": "A",
      "title": "减数分裂",
      "text": "# 减数分裂\n\n减数分裂中DNA复制一次，细胞连续分裂两次，产生染色体数目减半的生殖细胞。有丝分裂通常维持染色体数目。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "lever",
      "assignment": "A",
      "title": "杠杆平衡",
      "text": "# 杠杆平衡\n\n杠杆平衡条件为动力乘动力臂等于阻力乘阻力臂，即F1*l1=F2*l2。力臂是支点到力的作用线的垂直距离。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "buoyancy",
      "assignment": "A",
      "title": "阿基米德原理",
      "text": "# 阿基米德原理\n\n浮力大小等于物体排开液体所受的重力，F浮=ρ液gV排。浸没后继续增加深度通常不改变排液体积。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "pressure",
      "assignment": "A",
      "title": "压强",
      "text": "# 压强\n\n压强等于垂直作用于表面的压力除以受力面积，p=F/S。同样压力下，面积越小压强越大。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "series",
      "assignment": "A",
      "title": "串联电路",
      "text": "# 串联电路\n\n串联电路中各处电流相同，各元件两端电压之和等于总电压，等效电阻等于各电阻之和。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "parallel",
      "assignment": "A",
      "title": "并联电路",
      "text": "# 并联电路\n\n并联电路中各支路两端电压相同，干路电流等于各支路电流之和，各支路可独立工作。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "power",
      "assignment": "A",
      "title": "电功率",
      "text": "# 电功率\n\n电功率表示电能转化的快慢，P=UI，单位瓦特。电能W=Pt，单位焦耳或千瓦时，不能将功率直接当耗电量。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "refraction",
      "assignment": "A",
      "title": "光的折射",
      "text": "# 光的折射\n\n光从一种透明介质斜射入另一种时，传播方向通常改变，这叫折射。光在同一均匀介质中沿直线传播。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "derivative",
      "assignment": "A",
      "title": "导数",
      "text": "# 导数\n\n导数刻画函数在一点的瞬时变化率，是该点切线斜率。区间平均变化率是割线斜率，二者不能总是等同。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "median",
      "assignment": "A",
      "title": "中位数",
      "text": "# 中位数\n\n将数据排序，奇数个数据的中位数是中间的数，偶数个取中间两数的平均。中位数通常比均值更不容易受极端值影响。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "variance",
      "assignment": "A",
      "title": "方差",
      "text": "# 方差\n\n方差是各数据与均值之差的平方的平均，用于描述离散程度。数据整体加同一个常数，方差不变；整体乘a后方差乘a²。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "catalyst",
      "assignment": "A",
      "title": "催化剂",
      "text": "# 催化剂\n\n催化剂改变反应路径并降低活化能，提高正逆反应速率，但不改变平衡常数或最终平衡组成。它不能令热力学不允许的反应自发发生。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "equilibrium",
      "assignment": "A",
      "title": "化学平衡移动",
      "text": "# 化学平衡移动\n\n改变温度可能改变平衡常数。升温有利于吸热方向，降温有利于放热方向；平衡移动与反应速率加快不是同一个概念。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "passive",
      "assignment": "A",
      "title": "被动语态",
      "text": "# 被动语态\n\n英语被动语态通常由be动词加过去分词构成，用于突出动作承受者。施事者可用by短语表示，也可省略。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "hyperbole",
      "assignment": "A",
      "title": "夸张修辞",
      "text": "# 夸张修辞\n\n夸张有意放大或缩小事物特征以加强表达效果，例如等了一个世纪，不应把这种表达直接当成精确事实。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "cohesion",
      "assignment": "A",
      "title": "语篇衔接",
      "text": "# 语篇衔接\n\n语篇衔接可通过代词指代、连接词和词汇复现建立句间联系。however表示转折，therefore表示因果中的结果。",
      "source_version": 1,
      "status": "active"
    },
    {
      "id": "microscope",
      "assignment": "A",
      "title": "显微镜操作资料",
      "text": "# 显微镜定位\n\n观察标本时先使用低倍物镜定位，再将目标移到视野中央。调节照明使视野明亮，先从侧面观察镜头与载玻片的距离，再缓慢调焦。标本必须平整固定，气泡和厚薄不匀会影响观察。记录时注明观察部位、放大倍率和可见结构，不能用想象代替观察到的现象。若目标已经移出视野，应回到低倍重新寻找。该合成练习没有规定仪器品牌、学校名称或采购价格。保持载物台与镜头之间有安全距离，可以避免压碎载玻片。先定位再放大是操作顺序，不是对物体真实尺寸的改变。\n\n# 高倍观察\n\n换用高倍物镜后只能用细准焦螺旋微调，不再大幅转动粗准焦螺旋。高倍下视野变小变暗，需要调整照明。放大倍率等于目镜倍数乘物镜倍数。清楚观察到细节并不代表能看见所有细胞器，光学分辨率仍有限制。操作员需要保护镜片与标本，不把镜头压向载玻片。记录应区分实际观察和推断，不能把未见到的结构强写入观察图。合成资料没有提供这台仪器的产品序列号，也没有提供任何学生身份信息。\n\n# 镜片清洁\n\n清洁显微镜镜片应使用专用镜头纸，不能用普通纱布或手指擦拭。实验后移走标本并清洁载物台，恢复低倍镜位置，按规范遮盖保存。镜片表面残留油污会降低图像质量，清洁工具必须与光学表面要求相符。镜头纸用于保护镜片，不是记录学生答案的纸张。设备维护与生物观察属于不同环节，需要分别记录。合成练习不提供特定品牌配套清洁剂的成分和购买渠道，也不列出仪器维修联系电话。",
      "source_version": 1,
      "status": "active"
    },

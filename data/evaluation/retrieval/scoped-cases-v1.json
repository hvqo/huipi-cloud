    {
      "id": "heat",
      "assignment": "A",
      "title": "热传导",
      "text": "# 热传导\n\n热传导是物质直接接触时由高温处向低温处传递能量的方式。金属通常是良导体。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "convection",
      "assignment": "A",
      "title": "热对流",
      "text": "# 热对流\n\n热对流通过液体或气体整体流动传递热量，热空气上升和冷空气下降形成循环。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "radiation",
      "assignment": "A",
      "title": "热辐射",
      "text": "# 热辐射\n\n热辐射依靠电磁波传递能量，不要求物质介质，太阳辐射可以穿过真空到达地球。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "photo",
      "assignment": "A",
      "title": "光合作用",
      "text": "# 光合作用\n\n光合作用中绿色植物利用光能，把二氧化碳和水合成为有机物并释放氧气。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "respire",
      "assignment": "A",
      "title": "细胞呼吸",
      "text": "# 细胞呼吸\n\n细胞有氧呼吸分解葡萄糖，消耗氧气，产生二氧化碳和水并释放可利用的能量。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "neutral",
      "assignment": "A",
      "title": "酸碱中和",
      "text": "# 酸碱中和\n\n酸碱中和反应中酸与碱生成盐和水。氢离子和氢氧根离子结合形成水。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "oxidation",
      "assignment": "A",
      "title": "氧化还原",
      "text": "# 氧化还原\n\n氧化还原反应涉及电子转移。失去电子是氧化，得到电子是还原。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "speed",
      "assignment": "A",
      "title": "平均速度",
      "text": "# 平均速度\n\n平均速度计算为路程除以时间，即v=s/t。单位需要一致，千米每小时可以换算成米每秒。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "friction",
      "assignment": "A",
      "title": "滑动摩擦",
      "text": "# 滑动摩擦\n\n滑动摩擦力阻碍物体间相对滑动。接触面性质和正压力会影响其大小。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "energy",
      "assignment": "A",
      "title": "机械能守恒",
      "text": "# 机械能守恒\n\n只有重力或弹力做功时，动能与势能可以互相转化，机械能总量保持不变。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "fraction",
      "assignment": "A",
      "title": "约分",
      "text": "# 约分\n\n分子和分母同时除以最大公因数可以把分数约成最简形式，例如6/8约分为3/4。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "probability",
      "assignment": "A",
      "title": "概率",
      "text": "# 概率\n\n等可能有限样本空间内，事件概率等于满足条件的结果数除以所有可能结果数。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "simile",
      "assignment": "A",
      "title": "比喻",
      "text": "# 比喻\n\n比喻通过事物之间的相似点把本体比作喻体，使描述更加形象。比喻不等于拟人。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "thesis",
      "assignment": "A",
      "title": "论点和论据",
      "text": "# 论点和论据\n\n论点是作者要证明的观点，论据是用来支持观点的事实或道理。引用事实不能替代明确的观点。",
      "status": "active",
      "source_version": 1
    },
    {
      "id": "past",
      "assignment": "A",
      "title": "一般过去时",
      "text": "# 一般过去时\n\n英语一般过去时表示过去发生的动作，规则动词通常加ed，不规则动词需要记忆其过去式。",
      "status": "active",
      "source_version": 1
    },
    {

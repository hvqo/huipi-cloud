APP_NAME=慧批云端
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
POSTGRES_DB=huipi_cloud
POSTGRES_USER=huipi_cloud
POSTGRES_PASSWORD=local-dev-only
POSTGRES_TEST_DB=huipi_cloud_test
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://huipi_cloud:local-dev-only@127.0.0.1:55432/huipi_cloud
TEST_DATABASE_URL=postgresql+asyncpg://huipi_cloud:local-dev-only@127.0.0.1:55432/huipi_cloud_test
MINIO_ENDPOINT_URL=http://127.0.0.1:59000
MINIO_ACCESS_KEY=huipi-local
MINIO_SECRET_KEY=local-only-change-this-before-use
MINIO_BUCKET=huipi-cloud
MINIO_TEST_BUCKET=huipi-cloud-test
MINIO_OBJECT_KEY_PREFIX=
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MAX_UPLOAD_SIZE_BYTES=20971520
PARSING_MAX_ATTEMPTS=3
PARSING_LEASE_SECONDS=60
PARSING_HEARTBEAT_SECONDS=15
PARSING_POLL_SECONDS=1
PARSING_RETRY_BASE_SECONDS=5
PARSING_RETRY_MAX_SECONDS=300
PARSING_SHUTDOWN_GRACE_SECONDS=30
# Wait this long for a parser to honor cancellation before the worker fail-stops.
PARSING_CANCEL_GRACE_SECONDS=5
# Maximum total execution time for a cooperative async parser; this is not OS process isolation.
PARSING_EXECUTION_TIMEOUT_SECONDS=1800
# Configure these after installing MinerU 4.x and the Basic/ONNX model in a separate local runtime.
# PARSING_EXECUTOR=huipi_cloud.infrastructure.parsing.mineru:build_mineru_executor
# MINERU_EXECUTABLE=/absolute/path/to/mineru-venv/bin/mineru-kit
# MINERU_HOME=/absolute/path/to/mineru-home
MINERU_TIER=basic
MINERU_MAX_PDF_PAGES=200
MINERU_MAX_OUTPUT_BYTES=1073741824
MINERU_MAX_TEXT_BYTES=67108864
MINERU_MAX_ARCHIVE_MEMBERS=10000
CANONICAL_MAX_MIDDLE_JSON_BYTES=67108864
CANONICAL_MAX_MANIFEST_BYTES=16777216
CANONICAL_MAX_DOCUMENT_BYTES=33554432
CANONICAL_MAX_NODES=50000
CANONICAL_MAX_NESTING_DEPTH=64
ANSWER_ALIGNMENT_MAX_DOCUMENT_BYTES=33554432
ANSWER_ALIGNMENT_MAX_QUESTION_RESPONSE_BYTES=2097152
GRADE_INPUT_MAX_TEXT_BYTES=1048576
GRADE_INPUT_MAX_DOCUMENT_BYTES=4194304
# Cloud inference is disabled until a local Key and data authorization are configured.
GRADING_ENABLED=false
GRADING_PROVIDER=openai_compatible
GRADING_BASE_URL=https://api.deepseek.com
GRADING_MODEL=deepseek-flash
# Set only for an explicitly approved HTTPS endpoint and authorized student data.
GRADING_ALLOW_REMOTE=false
GRADING_EXTERNAL_DATA_AUTHORIZED=false
# GRADING_API_KEY=
GRADING_DEEPSEEK_THINKING=disabled
GRADING_DEEPSEEK_REASONING_EFFORT=max
GRADING_TIMEOUT_SECONDS=120
GRADING_MAX_OUTPUT_TOKENS=4096
GRADING_MAX_INPUT_BYTES=32768
GRADING_MAX_INPUT_TOKENS=49152
GRADING_MAX_PROPOSAL_BYTES=524288
GRADING_MAX_RATIONALE_CHARACTERS=1600
GRADING_MAX_QUOTE_CHARACTERS=400
GRADING_INVALID_RESPONSE_RETRIES=0
# VLM uses the cloud endpoint; no silent fallback to a local model.
VISUAL_EVIDENCE_ENABLED=false
VISUAL_EVIDENCE_PROVIDER=openai_compatible
VISUAL_EVIDENCE_BASE_URL=https://api.deepseek.com
VISUAL_EVIDENCE_MODEL=deepseek-flash
# Set only for an explicitly approved HTTPS endpoint and authorized student data.
VISUAL_EVIDENCE_ALLOW_REMOTE=false
VISUAL_EVIDENCE_EXTERNAL_DATA_AUTHORIZED=false
# VISUAL_EVIDENCE_API_KEY=
VISUAL_EVIDENCE_DEEPSEEK_THINKING=disabled
VISUAL_EVIDENCE_DEEPSEEK_REASONING_EFFORT=max
VISUAL_EVIDENCE_TIMEOUT_SECONDS=90
VISUAL_EVIDENCE_MAX_RETRIES=0
VISUAL_EVIDENCE_MAX_OUTPUT_TOKENS=2048
VISUAL_EVIDENCE_MAX_PAGES_PER_QUESTION=5
VISUAL_EVIDENCE_MAX_ORIGINAL_BYTES=20971520
VISUAL_EVIDENCE_MAX_SOURCE_PDF_PAGES=200
VISUAL_EVIDENCE_MAX_IMAGE_PIXELS=12000000
VISUAL_EVIDENCE_RENDER_DPI=120
VISUAL_EVIDENCE_MAX_RENDER_EDGE=2048
VISUAL_EVIDENCE_MAX_PAGE_IMAGE_BYTES=3145728
VISUAL_EVIDENCE_MAX_TOTAL_INPUT_BYTES=12582912
VISUAL_EVIDENCE_MAX_PROPOSAL_BYTES=2097152

# Keep ENABLED and remote authorization off until the operator approves the data scope.
# max is retained in config; no effort is sent while Thinking is disabled.
# Enabling Thinking later requires a new explicit token, timeout and cost budget.

# Teacher Copilot: local CLI only; cloud access stays disabled by default.
# Set a separate key locally, or explicitly pass --use-grading-key to the CLI.
COPILOT_ENABLED=false
COPILOT_API_KEY=
COPILOT_BASE_URL=https://api.deepseek.com
COPILOT_MODEL=deepseek-flash
COPILOT_ALLOW_REMOTE=false
COPILOT_EXTERNAL_DATA_AUTHORIZED=false
# P4-A fixes Thinking=disabled. No reasoning_effort is sent.
COPILOT_MAX_MODEL_CALLS=4
COPILOT_MAX_TOOL_CALLS=6
COPILOT_MAX_STEPS=12
COPILOT_MAX_CONTEXT_TOKENS=16384
COPILOT_MAX_OUTPUT_TOKENS=1024
COPILOT_MAX_TOOL_RESULT_BYTES=8192
COPILOT_MODEL_TIMEOUT_SECONDS=30
COPILOT_TOOL_TIMEOUT_SECONDS=5
COPILOT_TOTAL_TIMEOUT_SECONDS=90
COPILOT_BUDGET_USD=0.05

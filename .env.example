APP_NAME=慧批云端
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
POSTGRES_DB=huipi_cloud
POSTGRES_USER=huipi_cloud
POSTGRES_PASSWORD=local-dev-only
POSTGRES_TEST_DB=huipi_cloud_test
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://huipi_cloud:local-dev-only@127.0.0.1:55432/huipi_cloud
TEST_DATABASE_URL=postgresql+asyncpg://huipi_cloud:local-dev-only@127.0.0.1:55432/huipi_cloud_test
MINIO_ENDPOINT_URL=http://127.0.0.1:59000
MINIO_ACCESS_KEY=huipi-local
MINIO_SECRET_KEY=local-only-change-this-before-use
MINIO_BUCKET=huipi-cloud
MINIO_TEST_BUCKET=huipi-cloud-test
MINIO_OBJECT_KEY_PREFIX=
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MAX_UPLOAD_SIZE_BYTES=20971520
PARSING_MAX_ATTEMPTS=3
PARSING_LEASE_SECONDS=60
PARSING_HEARTBEAT_SECONDS=15
PARSING_POLL_SECONDS=1
PARSING_RETRY_BASE_SECONDS=5
PARSING_RETRY_MAX_SECONDS=300
PARSING_SHUTDOWN_GRACE_SECONDS=30
# Wait this long for a parser to honor cancellation before the worker fail-stops.
PARSING_CANCEL_GRACE_SECONDS=5
# Maximum total execution time for a cooperative async parser; this is not OS process isolation.
PARSING_EXECUTION_TIMEOUT_SECONDS=1800
# Configure these after installing MinerU 4.x and the Basic/ONNX model in a separate local runtime.
# PARSING_EXECUTOR=huipi_cloud.infrastructure.parsing.mineru:build_mineru_executor
# MINERU_EXECUTABLE=/absolute/path/to/mineru-venv/bin/mineru-kit
# MINERU_HOME=/absolute/path/to/mineru-home
MINERU_TIER=basic
MINERU_MAX_PDF_PAGES=200
MINERU_MAX_OUTPUT_BYTES=1073741824
MINERU_MAX_TEXT_BYTES=67108864
MINERU_MAX_ARCHIVE_MEMBERS=10000
CANONICAL_MAX_MIDDLE_JSON_BYTES=67108864
CANONICAL_MAX_MANIFEST_BYTES=16777216
CANONICAL_MAX_DOCUMENT_BYTES=134217728
CANONICAL_MAX_NODES=50000
CANONICAL_MAX_NESTING_DEPTH=64
